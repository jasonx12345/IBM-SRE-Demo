{
  "uid": "toil-budget",
  "title": "Toil Budget \u00b7 analysis & service health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "tags": [
    "sre",
    "toil",
    "slo"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Model assumptions",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "All toil figures are **estimates**. Annualization uses explicit dataset coverage. Runbook repeat is the automation-confidence proxy. Shared dataset metrics use `max` across replicas; request metrics use `sum`. See MODEL.md and LIMITATIONS.md. SLO: 99% of API requests within 300 ms, fewer than 1% HTTP 5xx over 30 days."
      }
    },
    {
      "id": 2,
      "title": "Estimated annual toil hours",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "expr": "sum(max by(alert_name) (toil_budget_estimated_annual_toil_hours{job=\"toil-budget\"}))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Estimated annual hours recoverable \u00b7 top 3",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "targets": [
        {
          "expr": "max(toil_budget_automation_recoverable_hours{job=\"toil-budget\"})",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
